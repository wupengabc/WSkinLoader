{
  "schemaVersion": 1,
  "id": "wskinloader",
  "version": "${version}",
  "name": "WSkinLoader",
  "description": "皮肤加载补丁, 支持加载非正版源的皮肤",
  "authors": ["wupeng"],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/wskinloader/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.wupeng.wskinloader.client.WskinloaderClient"
    ],
    "modmenu": [
      "com.wupeng.wskinloader.client.config.ModMenuIntegration"
    ]
  },
  "mixins": [
    {
      "config": "wskinloader.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric": "*",
    "minecraft": "~1.16.5",
    "java": ">=8"
  },
  "recommends": {
    "modmenu": "*"
  }
}
